{
    "name": "isy-thl/dss-csc-signing",
    "description": "Framework-independent DSS and CSC JAdES signing integration",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-4": {
            "IsyThl\\Signing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IsyThl\\Signing\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "format": "phpcbf --standard=phpcs.xml src tests",
        "style": "phpcs --standard=phpcs.xml",
        "analyse": "phpstan analyse --configuration=phpstan.neon"
    }
}